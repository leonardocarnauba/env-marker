{
  "manifest_version": 3,
  "name": "Env Marker",
  "version": "1.0.0",
  "description": "Marca ambientes (PRD/STG/DEV) com barra colorida no topo para distinguir ambientes de relance.",
  "author": "Leonardo Carnauba",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Env Marker"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
